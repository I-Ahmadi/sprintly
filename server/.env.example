# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sprintly"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sprintly"

# Server
PORT=3000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_MS=604800000

# Uploads
UPLOAD_DIR=./uploads
AVATAR_MAX_FILE_SIZE=2097152

# Brevo transactional email (optional locally, required in production)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Sprintly
